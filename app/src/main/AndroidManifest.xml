<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Core function: the app reacts to hardware keys while backgrounded, so setup step 2 asks for
         the doze exemption; without this the system dialog refuses to show. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Reads a connected/paired Bluetooth device's address and name for the automation trigger
         picker and its device-connected/disconnected events. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy install-time permission BLUETOOTH_CONNECT replaces on API 31+. Below that (down to
         minSdk 30), getBondedDevices()/getName() still need this instead. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Requested only when the user taps "Pick on screen"; the manual X/Y fields work without it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Normal permission, granted at install; it is what makes the app eligible to appear in the
         system's Do Not Disturb access list at all. The actual grant (isNotificationPolicyAccessGranted)
         is still a user action via ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS, required for
         cycle_ringer_mode/change_ringer_mode's Silent transition. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Special permission for the app_in_foreground constraints; the grant is a user action in
         the system's Usage Access list, and without it those constraints read as unknown. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only for reading the current Wi-Fi SSID in the connected_to_wifi_network constraint, which
         Android gates behind location. Requested at runtime; without it the constraint reads as
         unknown. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Special permission: declaring it only makes the app eligible for the "Modify system
         settings" list. The grant (Settings.System.canWrite) is a user action via
         ACTION_MANAGE_WRITE_SETTINGS, and it is what lets the brightness and screen-rotation
         actions run without Advanced Mode. Every write is gated on canWrite. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- The torch runs through CameraManager.setTorchMode, which needs no permission. CAMERA is
         deliberately not declared: it would put "take pictures and videos" on the store listing
         for a capability this app does not have. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Lets the action picker list launchable apps. A manifest declaration, not a runtime
         permission: the user sees no dialog, and QUERY_ALL_PACKAGES (which needs a Play Store
         policy declaration) is not required. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- AdMob app ID. Supplied by app/build.gradle.kts from local.properties or the
             environment, so no real AdMob identifier is committed to this public repository; a
             checkout without one falls back to Google's public test app ID. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Component names are fully qualified because the Kotlin sources still live in
             com.example while the namespace/applicationId is io.github.nicholasarda.keysnap. -->
        <activity
            android:name="com.example.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.example.service.KeyMapperAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name="com.example.service.adb.WirelessAdbHelperService"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false"
            android:exported="false" />

        <service
            android:name="com.example.service.ScreenPointPickerService"
            android:exported="false" />

        <receiver
            android:name="com.example.service.adb.PairingNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.action.SUBMIT_PAIRING_CODE" />
            </intent-filter>
        </receiver>
</application>

</manifest>
