<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Only the opt-in restart setting schedules work after the first unlock following reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Granted by the user's Advanced Mode bridge only for automatic restart; removed on disable.
         Only adb_wifi_enabled is written, never USB debugging or the paired-key security timeout. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Core function: the app reacts to hardware keys while backgrounded, so setup step 2 asks for
         the doze exemption; without this the system dialog refuses to show. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Reads a connected/paired Bluetooth device's address and name for the automation trigger
         picker and its device-connected/disconnected events. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy install-time permission BLUETOOTH_CONNECT replaces on API 31+. Below that (down to
         minSdk 30), getBondedDevices()/getName() still need this instead. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Requested only when the user taps "Pick on screen"; the manual X/Y fields work without it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Normal permission, granted at install; it is what makes the app eligible to appear in the
         system's Do Not Disturb access list at all. The actual grant (isNotificationPolicyAccessGranted)
         is still a user action via ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS, required for
         cycle_ringer_mode/change_ringer_mode's Silent transition. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Special permission for the app_in_foreground constraints; the grant is a user action in
         the system's Usage Access list, and without it those constraints read as unknown. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only for reading the current Wi-Fi SSID in the connected_to_wifi_network constraint, which
         Android gates behind location. Requested at runtime; without it the constraint reads as
         unknown. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Read-only, for the calendar_event_active condition; requested when the user adds it.
         Events are matched on the device and are never stored, logged or sent. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- "Alarms & reminders" (Android 12+; Android 11 needs nothing): only so the calendar
         condition's alarm rings on time at an event's start or end. Without the grant it falls
         back to an inexact alarm. Not USE_EXACT_ALARM, which Play keeps for alarm-clock and
         calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Special permission: declaring it only makes the app eligible for the "Modify system
         settings" list. The grant (Settings.System.canWrite) is a user action via
         ACTION_MANAGE_WRITE_SETTINGS, and it is what lets the brightness and screen-rotation
         actions run without Advanced Mode. Every write is gated on canWrite. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Normal permission, granted at install: the set_wallpaper action's WallpaperManager.setStream
         needs it. The image comes from the system photo picker, which needs no storage permission;
         READ_MEDIA_IMAGES is deliberately not declared, because it would put "photos and videos" on
         the store listing and require Play's photo-permissions declaration. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- The torch runs through CameraManager.setTorchMode, which needs no permission. CAMERA is
         deliberately not declared: it would put "take pictures and videos" on the store listing
         for a capability this app does not have. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Lets the action picker list launchable apps. A manifest declaration, not a runtime
         permission: the user sees no dialog, and QUERY_ALL_PACKAGES (which needs a Play Store
         policy declaration) is not required. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- "Send a message": which picked app opens an smsto: chat. Visibility only, not a permission. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- Component names are fully qualified because the Kotlin sources still live in
             com.example while the namespace/applicationId is io.github.nicholasarda.keysnap. -->
        <activity
            android:name="com.example.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Import: a shortcut shared as text or as a file from any app. Untrusted input:
                 ShortcutShare.decode validates it, the user reviews it, and nothing is saved
                 until they tap Done in the editor. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <service
            android:name="com.example.service.KeyMapperAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name="com.example.service.adb.WirelessAdbHelperService"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false"
            android:exported="false" />

        <service
            android:name="com.example.service.ScreenPointPickerService"
            android:exported="false" />

        <!-- Checks the RSS feeds automations follow, at most every 15 minutes and only while online. -->
        <receiver android:name="com.example.service.adb.AdvancedAutostartReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <service android:name="com.example.service.adb.AdvancedAutostartJobService"
            android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />

        <service
            android:name="com.example.service.RssPollJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Re-evaluates automations when a calendar condition's event starts or ends, and re-arms
             that alarm as an exact one when "Alarms & reminders" is granted. The system sends the
             grant broadcast, so the receiver stays unexported. -->
        <receiver
            android:name="com.example.service.CalendarAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Re-evaluates automations at the next "At a time", "Repeat every" or time-window boundary, and
             re-arms that alarm as an exact one when "Alarms & reminders" is granted. The system sends
             the grant broadcast, so the receiver stays unexported. -->
        <receiver
            android:name="com.example.service.TimeAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Notification access, a special access the user grants in Settings. Used only by the
             "Notification received" condition and the "Reply to notification" action: text is
             matched in memory for apps a condition names and never stored, logged or sent. -->
        <service
            android:name="com.example.service.NotificationEventListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.example.service.adb.PairingNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.action.SUBMIT_PAIRING_CODE" />
            </intent-filter>
        </receiver>

        <!-- One-tap shortcut widget. Exported because the system delivers widget broadcasts to it;
             it only draws. Runs go through ScriptRunReceiver, which is not exported. -->
        <receiver
            android:name="com.example.surface.ShortcutWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shortcut_widget_info" />
        </receiver>

        <receiver
            android:name="com.example.surface.ScriptRunReceiver"
            android:exported="false" />

        <!-- Exported: the widget host starts it to configure a new widget. It binds only this
             app's own widget ids. -->
        <activity
            android:name="com.example.surface.ShortcutPickerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Three Quick Settings tiles, each running the shortcut bound to its slot. Only the system
             can bind them (BIND_QUICK_SETTINGS_TILE); that is a protection attribute, not a
             permission the app requests. -->
        <service
            android:name="com.example.surface.ShortcutTile1"
            android:exported="true"
            android:icon="@drawable/ic_tile_bolt"
            android:label="@string/tile_label_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.example.surface.ShortcutTile2"
            android:exported="true"
            android:icon="@drawable/ic_tile_bolt"
            android:label="@string/tile_label_2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.example.surface.ShortcutTile3"
            android:exported="true"
            android:icon="@drawable/ic_tile_bolt"
            android:label="@string/tile_label_3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
</application>

</manifest>
