<?xml version="1.0" encoding="utf-8"?>
<!-- The Tiles form at one cell (WidgetForms): a square tile, icon on top, name below. The whole cell is the tap target. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/widget_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_shape_round_22"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="9dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="0.9"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/widget_label_dot"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
