<?xml version="1.0" encoding="utf-8"?>
<!-- The Big state form at one cell (WidgetForms): the state as the headline over a faint icon, the name, and a bar that fills when on. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/widget_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_shape_round_22"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/widget_headline_dot"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginTop="2dp"
                android:alpha="0.75"
                android:textSize="9.5sp" />

            <ImageView
                android:id="@+id/widget_label_dot"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_bar"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="9dp">

            <ImageView
                android:id="@+id/widget_bar_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_pill"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_bar_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_pill"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_bar_stub"
                android:layout_width="9dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_pill"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
