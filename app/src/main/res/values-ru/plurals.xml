<?xml version="1.0" encoding="utf-8"?>
<!-- Russian has four CLDR plural categories. "one" covers 1/21/31, "few" 2-4, "many" 0 and 5-20;
     without few and many every count from 2 to 4 reads as the genitive plural ("2 действий"). -->
<resources>
    <plurals name="scripts_action_count">
        <item quantity="one">%1$d действие</item>
        <item quantity="few">%1$d действия</item>
        <item quantity="many">%1$d действий</item>
        <item quantity="other">%1$d действий</item>
    </plurals>
    <plurals name="home_suggestion_steps">
        <item quantity="one">%1$d шаг</item>
        <item quantity="few">%1$d шага</item>
        <item quantity="many">%1$d шагов</item>
        <item quantity="other">%1$d шагов</item>
    </plurals>
    <plurals name="run_all">
        <item quantity="one">Выполнено %1$d действие</item>
        <item quantity="few">Выполнены все %1$d действия</item>
        <item quantity="many">Выполнены все %1$d действий</item>
        <item quantity="other">Выполнены все %1$d действий</item>
    </plurals>
    <plurals name="settings_log_event_count">
        <item quantity="one">%1$d событие</item>
        <item quantity="few">%1$d события</item>
        <item quantity="many">%1$d событий</item>
        <item quantity="other">%1$d событий</item>
    </plurals>
    <plurals name="saved_needs_config">
        <item quantity="one">Сохранено. %1$d действие ещё требует настройки.</item>
        <item quantity="few">Сохранено. %1$d действия ещё требуют настройки.</item>
        <item quantity="many">Сохранено. %1$d действий ещё требуют настройки.</item>
        <item quantity="other">Сохранено. %1$d действий ещё требуют настройки.</item>
    </plurals>
</resources>
