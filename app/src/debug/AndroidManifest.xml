<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only look lab; never in a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.example.surface.WidgetLabProvider"
            android:exported="true"
            android:label="KeySnap Lab">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lab_info" />
        </receiver>

        <service
            android:name="com.example.surface.WidgetLabTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_bolt"
            android:label="KeySnap Lab"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
